{
  // Covers the supplied harness (spec/, scripts/) and the app: server/,
  // shared/ and the client.
  "compilerOptions": {
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    // Imports name the file they mean, extension and all --- which is what
    // node itself wants when it runs a .ts file directly.
    "allowImportingTsExtensions": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "moduleDetection": "force",
    "verbatimModuleSyntax": true,
    // the server runs its .ts directly under node, which only strips types
    "erasableSyntaxOnly": true,
    "jsx": "react-jsx"
  },
  "include": ["*.ts", "spec", "scripts", "server", "shared", "client/src"]
}
