{
  // Covers the harness (spec/, scripts/, .claude/hooks/) and the app's three
  // folders (ADR 0007). Node runs the .ts source directly by stripping types
  // (ADR 0003), so only erasable syntax is allowed: no enums, namespaces or
  // parameter properties.
  "compilerOptions": {
    "erasableSyntaxOnly": true,
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "bundler",
    // Imports name the file they mean, extension and all --- which is what
    // node itself wants when it runs a .ts file directly.
    "allowImportingTsExtensions": true,
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "moduleDetection": "force",
    "verbatimModuleSyntax": true
  },
  "include": ["*.ts", "spec", "scripts", ".claude/hooks", "server", "client", "shared"]
}
