# What a remote build uploads from your working tree. CI checkouts carry none
# of this, so it only matters for a deploy run from your own machine; without
# it, node_modules and any local data ship to the builder.
.git
node_modules
dist
*.log
.DS_Store
._*
Thumbs.db
Desktop.ini
.env
.env.*
.envrc
mise.local.toml
*.pem
# Skills are tracked as project evidence, but are not needed to build or run
# the game. Exclude agent configuration and docs from the deployment context.
.claude
.codex
.agents
skills-lock.json
CLAUDE.md
AGENTS.md
GLOSSARY.md
GLOSSARY-MAP.md
docs
data
