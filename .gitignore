node_modules/
dist/
*.log

# editor and OS junk
.DS_Store
._*
Thumbs.db
Desktop.ini

# keep secrets out of the repo: your API key lives in an env var or an
# untracked file, never in a tracked one
.env
.env.*
.envrc
mise.local.toml
*.pem

# Track skill sources in .agents/skills/, skills-lock.json, and Claude's
# skill shortcuts as project evidence, plus the shared project settings and
# their hooks (permissions and the deploy guard; no keys). Keep other Claude
# files machine-local: settings.local.json can contain API keys.
.claude/*
!.claude/skills/
!.claude/settings.json
!.claude/hooks/
